# ---------------------------------------------------------------------------
# Cafe Management System - backend configuration template.
# Copy this file to ".env" (which is git-ignored) or set these as real
# environment variables before starting the Spring Boot application.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- MySQL -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cafe_management_db
DB_USER=root
# Your local MySQL password (leave empty if the root user has no password).
DB_PASSWORD=

# --- Hibernate -------------------------------------------------------------
DDL_AUTO=update
SHOW_SQL=true

# --- Server ----------------------------------------------------------------
SERVER_PORT=8080

# --- JWT -------------------------------------------------------------------
# Must be at least 32 characters long for HS256. Change this in real deployments.
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- First admin bootstrap -------------------------------------------------
# An ADMIN account is created at startup only if this email does not exist yet.
ADMIN_EMAIL=admin@cafe.com
ADMIN_PASSWORD=Admin@123

# --- Demo staff account ----------------------------------------------------
# Created at startup only when the users table contains no STAFF user yet.
STAFF_EMAIL=ravi@cafe.com
STAFF_PASSWORD=Staff@123

# --- Cafe details used on the invoice --------------------------------------
CAFE_NAME=Kettle & Kitchen
CAFE_ADDRESS=123 Coffee Street, Bengaluru, India
CAFE_PHONE=+91 98765 43210
CAFE_CURRENCY=INR

# --- Alternative sign-in: brute-force protection ---------------------------
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- Alternative sign-in: phone + one-time code ----------------------------
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# 'log'   -> write the code to the application log (development only!)
# 'http'  -> POST {"to","message"} to OTP_SMS_URL
# any other value switches phone sign-in off
OTP_SMS_PROVIDER=log
OTP_SMS_URL=
OTP_SMS_TOKEN=
OTP_SMS_SENDER_ID=

# --- Alternative sign-in: Google -------------------------------------------
# OAuth 2.0 Web Client ID from Google Cloud Console. Empty = button disabled.
GOOGLE_CLIENT_ID=

# --- Alternative sign-in: Apple --------------------------------------------
# Apple Service ID, e.g. com.yourcafe.web. Empty = button disabled.
APPLE_CLIENT_ID=
